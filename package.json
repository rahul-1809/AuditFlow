{
  "name": "auditflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "test": "node test-e2e-api.js",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:worker": "node --experimental-strip-types test-cloudflare-worker.js",
    "create-admin": "node scripts/create-admin.js",
    "d1:migrate": "wrangler d1 migrations apply auditflow-db --remote",
    "d1:migrate:local": "wrangler d1 migrations apply auditflow-db --local",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.149.0"
  }
}
